---
// Books list page with pagination
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchBooks } from '../../services/api';
import type { SearchParams } from '../../services/types';
import Button from '../../components/ui/Button.astro';
import ErrorState from '../../components/ui/ErrorState.astro';
import BookCard from '../../components/book/BookCard.astro';
import { getReadCounts, getStatsEnv } from '../../server/stats';

export interface Props {
  page?: number;
  sort?: 'newest' | 'oldest' | 'popular' | 'title-asc' | 'title-desc';
  category?: string;
  q?: string;
}

const { searchParams } = Astro.url;
const page = Number(searchParams.get('page')) || 1;
const sort = (searchParams.get('sort') as Props['sort']) ?? 'newest';
const category = searchParams.get('category') ?? undefined;
const q = searchParams.get('q') ?? undefined;

const limit = 20;
const params: SearchParams = { page, limit, sort, category, q };

// "Populer" memakai jumlah pembaca nyata, bukan jumlah halaman.
const readCounts = await getReadCounts(getStatsEnv(Astro.locals));

let booksData;
let error: string | null = null;

try {
  booksData = await fetchBooks(params, { readCounts });
} catch (e) {
  error = e instanceof Error ? e.message : 'Gagal memuat daftar buku';
}

const totalPages = booksData?.pagination.totalPages ?? 1;
const currentPage = booksData?.pagination.page ?? 1;
const hasNextPage = currentPage < totalPages;
const hasPrevPage = currentPage > 1;

const sortOptions = [
  { value: 'newest', label: 'Terbaru' },
  { value: 'oldest', label: 'Terlama' },
  { value: 'popular', label: 'Populer' },
  { value: 'title-asc', label: 'Judul A-Z' },
  { value: 'title-desc', label: 'Judul Z-A' },
];

const pageTitle = q
  ? `Hasil pencarian: "${q}"`
  : category
  ? `Kategori: ${category}`
  : 'Semua Buku';

const pageDescription = q
  ? `Hasil pencarian untuk "${q}" - ${booksData?.data.length ?? 0} buku ditemukan`
  : `Jelajahi koleksi buku lengkap di Pojok Baca RPL`;

const buildUrl = (nextPage: number) => {
  const sp = new URLSearchParams();
  sp.set('page', String(nextPage));
  sp.set('sort', sort);
  if (category) sp.set('category', category);
  if (q) sp.set('q', q);
  return `/books/?${sp.toString()}`;
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="flex-1">
    <div class="container py-8 sm:py-10">
      <!-- Page Header -->
      <header class="mb-8">
        <h1 class="text-2xl sm:text-3xl font-bold text-text">{pageTitle}</h1>
        <p class="mt-2 text-text-muted">
          {booksData?.pagination.total ?? 0} buku ditemukan
          {q && <span class="text-text-light"> — pencarian mencocokkan judul, penulis, dan sinopsis</span>}
        </p>
      </header>

      {/* Sort — satu-satunya tempat pengurutan (header hanya navigasi) */}
      <div class="mb-8">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Urutkan">
          {sortOptions.map(option => (
            <button
              type="button"
              class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-200 ${
                sort === option.value
                  ? 'bg-primary text-background'
                  : 'bg-surface text-text-muted hover:bg-secondary hover:text-text'
              }`}
              aria-pressed={sort === option.value}
              data-sort={option.value}
            >
              {option.label}
            </button>
          ))}
        </div>
      </div>

      {/* Books Grid */}
      {error ? (
        <ErrorState
          title="Gagal Memuat Buku"
          message={error}
          actionLabel="Coba Lagi"
          actionHref={Astro.url.pathname}
          variant="page"
        />
      ) : booksData?.data.length === 0 ? (
        <ErrorState
          title="Tidak Ada Buku Ditemukan"
          message="Coba kata kunci lain — misalnya potongan alur cerita yang kamu ingat."
          actionLabel="Lihat semua buku"
          actionHref="/books/"
          variant="page"
        />
      ) : (
        <>
          <div class="grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4 xl:grid-cols-5" role="list" aria-label="Daftar buku">
            {booksData!.data.map(book => (
              <BookCard book={book} showReadCount={sort === 'popular'} />
            ))}
          </div>

          {/* Pagination */}
          {totalPages > 1 && (
            <nav class="mt-10 mb-12 flex items-center justify-center gap-2" aria-label="Navigasi halaman">
              <a
                href={hasPrevPage ? buildUrl(currentPage - 1) : '#'}
                class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
                  hasPrevPage ? 'bg-surface text-text hover:bg-secondary' : 'bg-secondary text-text-light cursor-not-allowed pointer-events-none'
                }`}
                aria-label="Halaman sebelumnya"
                aria-disabled={!hasPrevPage}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M15 18l-6-6 6-6" />
                </svg>
              </a>

              <div class="flex items-center gap-1" role="group" aria-label="Nomor halaman">
                {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
                  let pageNum: number;
                  if (totalPages <= 5) {
                    pageNum = i + 1;
                  } else if (currentPage <= 3) {
                    pageNum = i + 1;
                  } else if (currentPage >= totalPages - 2) {
                    pageNum = totalPages - 4 + i;
                  } else {
                    pageNum = currentPage - 2 + i;
                  }
                  return (
                    <a
                      href={buildUrl(pageNum)}
                      class={`w-10 h-10 flex items-center justify-center rounded-lg text-sm font-medium transition-colors ${
                        pageNum === currentPage
                          ? 'bg-primary text-background'
                          : 'text-text-muted hover:bg-secondary hover:text-text'
                      }`}
                      aria-label={`Halaman ${pageNum}`}
                      aria-current={pageNum === currentPage ? 'page' : undefined}
                    >
                      {pageNum}
                    </a>
                  );
                })}
              </div>

              <a
                href={hasNextPage ? buildUrl(currentPage + 1) : '#'}
                class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
                  hasNextPage ? 'bg-surface text-text hover:bg-secondary' : 'bg-secondary text-text-light cursor-not-allowed pointer-events-none'
                }`}
                aria-label="Halaman selanjutnya"
                aria-disabled={!hasNextPage}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M9 18l6-6-6-6" />
                </svg>
              </a>
            </nav>
          )}
        </>
      )}
    </div>
  </main>

  <script is:inline>
    // Sort mengubah URL agar hasil bisa dibagikan & tombol back bekerja.
    document.addEventListener('DOMContentLoaded', () => {
      const sortButtons = document.querySelectorAll('[data-sort]');
      const urlParams = new URLSearchParams(window.location.search);

      sortButtons.forEach(button => {
        button.addEventListener('click', () => {
          const sortValue = button.getAttribute('data-sort');
          if (!sortValue) return;
          urlParams.set('sort', sortValue);
          urlParams.set('page', '1');
          window.location.search = urlParams.toString();
        });
      });
    });
  </script>
</BaseLayout>
