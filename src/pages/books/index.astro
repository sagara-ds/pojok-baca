---
// Books list page with pagination
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchBooks, type SearchParams } from '../../services/api';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import Skeleton from '../../components/ui/Skeleton.astro';
import ErrorState from '../../components/ui/ErrorState.astro';
import CoverPlaceholder from '../../components/book/CoverPlaceholder.astro';

const { searchParams } = Astro.url;
const page = Number(searchParams.get('page')) || 1;
const category = searchParams.get('category') ?? undefined;
const q = searchParams.get('q') ?? undefined;

const limit = 20;
// Sort UI dihapus — tetap "Terbaru" secara default agar urutan konsisten
// dengan perilaku sebelumnya.
const params: SearchParams = { page, limit, sort: 'newest', category, q };

let booksData;
let error: string | null = null;

try {
  booksData = await fetchBooks(params);
} catch (e) {
  error = e instanceof Error ? e.message : 'Gagal memuat daftar buku';
}

const totalPages = booksData?.pagination.totalPages ?? 1;
const currentPage = booksData?.pagination.page ?? 1;
const hasNextPage = currentPage < totalPages;
const hasPrevPage = currentPage > 1;

const pageTitle = q
  ? `Hasil pencarian: "${q}"`
  : category
  ? `Kategori: ${category}`
  : 'Semua Buku';

const pageDescription = q
  ? `Hasil pencarian untuk "${q}" - ${booksData?.data.length ?? 0} buku ditemukan`
  : `Jelajahi koleksi buku lengkap di Pojok Baca RPL`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="flex-1">
    <div class="container py-6 sm:py-8">
      <!-- Page Header -->
      <header class="mb-6 sm:mb-8">
        <h1 class="text-2xl sm:text-3xl font-bold text-text">{pageTitle}</h1>
        <p class="mt-1 text-text-muted">{booksData?.pagination.total ?? 0} buku ditemukan</p>
      </header>

      {/* Books Grid */}
      {error ? (
        <ErrorState
          title="Gagal Memuat Buku"
          message={error}
          actionLabel="Coba Lagi"
          actionHref={Astro.url.pathname}
          variant="page"
        />
      ) : booksData?.data.length === 0 ? (
        <ErrorState
          title="Tidak Ada Buku Ditemukan"
          message="Coba ubah filter atau kata kunci pencarian."
          variant="page"
        />
      ) : (
        <>
          <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4 xl:grid-cols-5" role="list" aria-label="Daftar buku">
            {booksData!.data.map(book => (
              <Card
                variant="interactive"
                padding="none"
                href={`/books/${book.slug}/`}
                class="overflow-hidden flex flex-col"
                aria-label={`Lihat detail ${book.title}`}
              >
                <div class="relative aspect-[2/3] overflow-hidden">
                  {/* Placeholder desain selalu di belakang img — terlihat
                      saat asset cover 404 / belum dirender pipeline */}
                  <CoverPlaceholder title={book.title} author={book.author} />

                  {book.coverUrl && (
                    <img
                      src={book.coverUrl}
                      alt={`Cover buku ${book.title}`}
                      loading="lazy"
                      class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                      onerror="this.style.display='none'"
                      decoding="async"
                    />
                  )}
                </div>

                <div class="p-3 flex-1 flex flex-col">
                  <h2 class="font-semibold text-text line-clamp-2 mb-1">{book.title}</h2>
                  <p class="text-sm text-text-muted line-clamp-1 mb-2">{book.author}</p>

                  <div class="flex flex-wrap gap-1.5 mt-auto">
                    {book.category ? (
                      <span class="px-2 py-0.5 rounded text-xs font-medium truncate max-w-full bg-accent/10 text-accent-dark dark:text-accent-light">
                        {book.category}
                      </span>
                    ) : null}
                    {book.publishedYear ? (
                      <span class="hidden sm:inline-block px-2 py-0.5 rounded text-xs font-medium bg-secondary text-text-muted">
                        {book.publishedYear}
                      </span>
                    ) : null}
                  </div>
                </div>
              </Card>
            ))}
          </div>

          {/* Skeleton placeholders for loading state */}
          <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4 xl:grid-cols-5 hidden" data-skeleton-container aria-hidden="true">
            {Array.from({ length: 8 }).map((_, i) => (
              <Card variant="default" padding="none" class="overflow-hidden">
                <Skeleton variant="book-card" />
              </Card>
            ))}
          </div>

          {/* Pagination */}
          {totalPages > 1 && (
            <nav class="mt-8 flex items-center justify-center gap-2" aria-label="Navigasi halaman">
              <a
                href={hasPrevPage ? `/books/?page=${currentPage - 1}${category ? `&category=${category}` : ''}${q ? `&q=${encodeURIComponent(q)}` : ''}` : '#'}
                class:list={[
                  'px-3 py-2 rounded-lg text-sm font-medium transition-colors',
                  hasPrevPage
                    ? 'bg-surface text-text hover:bg-secondary'
                    : 'bg-secondary text-text-light cursor-not-allowed pointer-events-none',
                ]}
                aria-label="Halaman sebelumnya"
                aria-disabled={!hasPrevPage}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M15 18l-6-6 6-6" />
                </svg>
              </a>

              <div class="flex items-center gap-1" role="group" aria-label="Nomor halaman">
                {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
                  let pageNum: number;
                  if (totalPages <= 5) {
                    pageNum = i + 1;
                  } else if (currentPage <= 3) {
                    pageNum = i + 1;
                  } else if (currentPage >= totalPages - 2) {
                    pageNum = totalPages - 4 + i;
                  } else {
                    pageNum = currentPage - 2 + i;
                  }
                  return (
                    <a
                      key={pageNum}
                      href={`/books/?page=${pageNum}${category ? `&category=${category}` : ''}${q ? `&q=${encodeURIComponent(q)}` : ''}`}
                      class={`w-10 h-10 flex items-center justify-center rounded-lg text-sm font-medium transition-colors ${
                        pageNum === currentPage
                          ? 'bg-primary text-background'
                          : 'text-text-muted hover:bg-secondary hover:text-text'
                      }`}
                      aria-label={`Halaman ${pageNum}`}
                      aria-current={pageNum === currentPage ? 'page' : undefined}
                    >
                      {pageNum}
                    </a>
                  );
                })}
              </div>

              <a
                href={hasNextPage ? `/books/?page=${currentPage + 1}${category ? `&category=${category}` : ''}${q ? `&q=${encodeURIComponent(q)}` : ''}` : '#'}
                class:list={[
                  'px-3 py-2 rounded-lg text-sm font-medium transition-colors',
                  hasNextPage
                    ? 'bg-surface text-text hover:bg-secondary'
                    : 'bg-secondary text-text-light cursor-not-allowed pointer-events-none',
                ]}
                aria-label="Halaman selanjutnya"
                aria-disabled={!hasNextPage}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M9 18l6-6-6-6" />
                </svg>
              </a>
            </nav>
          )}
        </>
      )}
    </div>
  </main>
</BaseLayout>