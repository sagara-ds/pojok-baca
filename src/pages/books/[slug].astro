---
// Book detail page - dynamic route
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchBook, sanitizeHtml } from '../../services/api';
import { type Book } from '../../services/types';
import BookCover from '../../components/book/BookCover.astro';
import ReadButton from '../../components/book/ReadButton.astro';
import Card from '../../components/ui/Card.astro';
import ErrorState from '../../components/ui/ErrorState.astro';

export async function getStaticPaths() {
  // For static generation, we'd need a list of all book slugs
  // For now, return empty to use SSR mode
  return [];
}

export const prerender = false; // Use SSR for dynamic book pages

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/books/');
}

let book: Book | null = null;
let error: string | null = null;

try {
  book = await fetchBook(slug as string);
} catch (e) {
  error = e instanceof Error ? e.message : 'Gagal memuat detail buku';
}

if (!book && !error) {
  error = 'Buku tidak ditemukan';
}

// Buku dewasa/varian yang disembunyikan tidak boleh memberi status 200.
if (!book) {
  Astro.response.status = 404;
}

const pageTitle = book ? book.title : 'Buku Tidak Ditemukan';
const pageDescription = book
  ? `${book.title} oleh ${book.author} - ${book.description.slice(0, 160)}...`
  : 'Buku yang Anda cari tidak ditemukan';
const ogImage = book?.coverUrl;
const bookSynopsis = book ? sanitizeHtml(book.description).trim() : '';
const bookProlog = book?.prolog ? sanitizeHtml(book.prolog).trim() : '';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={`/books/${slug}/`}
  ogImage={ogImage}
  noIndex={!book}
  hideSearch={true}
>
  <main id="main-content" class="flex-1">
    <div class="container py-8 sm:py-10">
      {error ? (
        <ErrorState
          title={book ? 'Gagal Memuat Detail' : 'Buku Tidak Ditemukan'}
          message={error}
          actionLabel="Kembali ke Daftar Buku"
          actionHref="/books/"
          variant="page"
        />
      ) : book ? (
        <>
          {/* Breadcrumb */}
          <nav class="mb-8" aria-label="Breadcrumb">
            <ol class="flex items-center gap-2 text-sm text-text-muted" role="list">
              <li>
                <a href="/" class="hover:text-text hover:underline transition-colors">Beranda</a>
              </li>
              <li aria-hidden="true">/</li>
              <li>
                <a href="/books/" class="hover:text-text hover:underline transition-colors">Katalog</a>
              </li>
              <li aria-hidden="true">/</li>
              <li aria-current="page" class="text-text truncate max-w-xs">{book.title}</li>
            </ol>
          </nav>

          {/* Book Detail Layout — 2 kolom di desktop, stack di mobile */}
          <div class="grid gap-8 sm:grid-cols-[256px_1fr] items-start">
            {/* Cover */}
            <div class="self-start w-full max-w-xs mx-auto sm:mx-0 sm:sticky sm:top-24">
              <Card variant="elevated" padding="none" class="overflow-hidden">
                <BookCover
                  src={book.coverUrl}
                  title={book.title}
                  author={book.author}
                  alt={`Cover buku ${book.title}`}
                  width={256}
                  height={384}
                  priority
                />
              </Card>

              {/* Aksi di bawah cover — desktop */}
              <div class="mt-4 hidden md:flex md:flex-col md:gap-2">
                <ReadButton
                  slug={book.slug}
                  title={book.title}
                  readingUrl={book.readingUrl}
                  class="w-full justify-center"
                />
                {book.hasTextLayer && (
                  <a
                    href={`/books/${book.slug}/read/?mode=text`}
                    class="inline-flex w-full items-center justify-center gap-2 rounded-lg border-2 border-primary px-4 py-2 text-sm font-medium text-primary transition-colors hover:bg-primary/10"
                  >
                    Baca versi teks
                  </a>
                )}
                <button
                  type="button"
                  class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-border bg-surface px-4 py-2 text-sm font-medium text-text transition-colors hover:bg-secondary"
                  aria-pressed="false"
                  data-bookmark-toggle
                  data-slug={book.slug}
                  data-title={book.title}
                  data-author={book.author}
                  data-cover={book.coverUrl}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-bookmark-icon>
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                  </svg>
                  <span data-bookmark-label>Simpan</span>
                </button>
              </div>
            </div>

            {/* Book Info */}
            <div class="space-y-8">
              <header class="text-center sm:text-left">
                <h1 class="text-2xl sm:text-3xl font-bold text-text leading-tight">{book.title}</h1>
                <p class="mt-2 text-lg text-text-muted">{book.author}</p>
              </header>

              {/* Aksi — mobile */}
              <div class="flex flex-col gap-2 md:hidden">
                <ReadButton
                  slug={book.slug}
                  title={book.title}
                  readingUrl={book.readingUrl}
                  class="w-full justify-center"
                />
                {book.hasTextLayer && (
                  <a
                    href={`/books/${book.slug}/read/?mode=text`}
                    class="inline-flex w-full items-center justify-center gap-2 rounded-lg border-2 border-primary px-4 py-2 text-sm font-medium text-primary transition-colors hover:bg-primary/10"
                  >
                    Baca versi teks
                  </a>
                )}
                <button
                  type="button"
                  class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-border bg-surface px-4 py-2 text-sm font-medium text-text transition-colors hover:bg-secondary"
                  aria-pressed="false"
                  data-bookmark-toggle
                  data-slug={book.slug}
                  data-title={book.title}
                  data-author={book.author}
                  data-cover={book.coverUrl}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-bookmark-icon>
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                  </svg>
                  <span data-bookmark-label>Simpan</span>
                </button>
              </div>

              {/* Prolog — bagian terpisah, tidak tenggelam di halaman scan */}
              {bookProlog && (
                <section aria-labelledby="prolog-heading" class="prose text-text-muted">
                  <h2 id="prolog-heading" class="mb-2 text-lg font-semibold text-text">Prolog</h2>
                  <p set:html={bookProlog} />
                </section>
              )}

              {/* Sinopsis — tampil penuh */}
              <section aria-labelledby="synopsis-heading" class="prose text-text-muted">
                <h2 id="synopsis-heading" class="mb-2 text-lg font-semibold text-text">Sinopsis</h2>
                {bookSynopsis ? (
                  <p set:html={bookSynopsis} />
                ) : (
                  <p class="text-sm italic">Belum ada sinopsis untuk buku ini.</p>
                )}
              </section>
            </div>
          </div>

          {/* JSON-LD Book structured data */}
          <script type="application/ld+json" set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'Book',
            name: book.title,
            author: { '@type': 'Person', name: book.author },
            description: book.description,
            image: book.coverUrl,
            numberOfPages: book.pages || undefined,
            inLanguage: book.language || 'id',
            url: new URL(`/books/${book.slug}/`, Astro.site).href,
          })} />
        </>
      ) : null}
    </div>
  </main>
</BaseLayout>
