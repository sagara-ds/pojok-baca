---
/**
 * Halaman reader: /books/<slug>/read/
 *
 * Halaman ini berdiri sendiri (bukan memakai BaseLayout) karena reader
 * tampil penuh tanpa header/footer situs.
 */
import '../../../styles/global.css';
import Reader from '../../../components/reader/Reader.astro';
import TextReader from '../../../components/reader/TextReader.astro';
import { getBook, getReaderConfig } from '../../../services/books';
import { sanitizeText } from '../../../services/api';

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/books/');
}

const book = getBook(slug);
const config = getReaderConfig(slug);

if (!book || !config || (config.count < 1 && !config.hasTextLayer)) {
  return Astro.redirect(`/books/${slug}/`);
}

const title = sanitizeText(book.title);
const description = `Baca "${title}" oleh ${book.author} secara online di Pojok Baca.`;

// Mode teks hanya untuk buku yang punya lapisan teks asli.
const requestedMode = Astro.url.searchParams.get('mode');
const useTextMode = config.hasTextLayer && (requestedMode === 'text' || config.count < 1);
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Baca Online | Pojok Baca</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a2947" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#0f3c65" media="(prefers-color-scheme: light)" />
    <link rel="canonical" href={new URL(`/books/${slug}/read/`, Astro.site ?? 'https://pojokbaca.example.com').href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Terapkan tema sebelum render supaya tidak ada kedipan putih. */}
    <script is:inline>
      try {
        const stored = localStorage.getItem('pb:theme');
        const dark =
          stored === 'dark' ||
          (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      } catch (e) {
        /* localStorage tidak tersedia */
      }
    </script>
  </head>
  <body class="reader-body">
    {useTextMode ? (
      <TextReader slug={config.slug} title={title} author={book.author} textUrl={config.textUrl} />
    ) : (
      <Reader data={config} title={title} author={book.author} />
    )}

    {useTextMode && (
      <script>
        import { recordHistory, trackEvent } from '../../../scripts/library';

        const root = document.getElementById('text-reader');
        const slug = root?.dataset.slug;
        if (slug) {
          trackEvent('read', slug);
          recordHistory({
            slug,
            title: root?.dataset.title ?? slug,
            author: root?.dataset.author ?? '',
            cover: root?.dataset.cover ?? '',
          });
        }
      </script>
    )}

    {!useTextMode && (
      <script>
        import { initReader } from '../../../scripts/reader';
        initReader();
      </script>
    )}

    {/* Kalau setting default = teks dan buku punya lapisan teks, arahkan otomatis. */}
    {!useTextMode && config.hasTextLayer && (
      <script is:inline>
        try {
          const mode = localStorage.getItem('pb:mode');
          const params = new URLSearchParams(window.location.search);
          if (mode === 'text' && !params.has('mode')) {
            params.set('mode', 'text');
            window.location.replace(`/books/${window.location.pathname.split('/')[2]}/read/?${params.toString()}`);
          }
        } catch (e) {
          /* localStorage tidak tersedia */
        }
      </script>
    )}
  </body>
</html>

<style is:global>
  /* Reader berdiri sendiri: tidak ada scroll halaman, seluruh layar dipakai
     oleh panggung gambar. */
  html:has(.reader) {
    overflow: hidden;
  }

  body:has(.reader) {
    margin: 0;
    overscroll-behavior: none;
  }
</style>
