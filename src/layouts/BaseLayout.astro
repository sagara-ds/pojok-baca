---
// Base layout for all pages
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'Pojok Baca RPL - Temukan buku favoritmu di perpustakaan digital',
  canonicalURL,
  ogImage,
  noIndex = false,
} = Astro.props;

const siteTitle = 'Pojok Baca RPL';
const fullTitle = `${title} | ${siteTitle}`;
const siteURL = new URL(Astro.site ?? 'https://pojokbaca.example.com');
const canonical = canonicalURL ? new URL(canonicalURL, siteURL).href : siteURL.href;
const ogImageURL = ogImage ? new URL(ogImage, siteURL).href : new URL('/og-default.png', siteURL).href;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1a2e" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f1a" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <!-- Robots -->
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://id.welib.org" crossorigin />
    <link rel="dns-prefetch" href="https://id.welib.org" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteTitle,
      url: siteURL.href,
      description: description,
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${siteURL.href}books?q={search_term_string}`
        },
        'query-input': 'required name=search_term_string'
      }
    })} />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="skip-link">Lewati ke konten utama</a>

    <header class="border-b border-border sticky top-0 z-40 bg-background/95 backdrop-blur-sm" role="banner">
      <div class="container">
        <div class="flex items-center justify-between h-16">
          <!-- Logo/Title -->
          <a href="/" class="flex items-center gap-2 text-primary font-semibold text-lg" aria-label="Pojok Baca RPL - Beranda">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-accent">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
              <path d="M8 10h10" />
              <path d="M8 14h10" />
            </svg>
            <span class="hidden sm:inline">Pojok Baca RPL</span>
          </a>

          <!-- Navigation -->
          <nav class="hidden md:flex items-center gap-6" role="navigation" aria-label="Navigasi utama">
            <a href="/books" class="text-sm font-medium text-text-muted hover:text-text transition-colors">Semua Buku</a>
            <a href="/books?sort=newest" class="text-sm font-medium text-text-muted hover:text-text transition-colors">Terbaru</a>
            <a href="/books?sort=popular" class="text-sm font-medium text-text-muted hover:text-text transition-colors">Populer</a>
          </nav>

          <!-- Mobile menu button (placeholder for future) -->
          <button class="md:hidden p-2 text-text-muted hover:text-text transition-colors" aria-label="Buka menu" aria-expanded="false">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="6" x2="21" y2="6" />
              <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content" class="flex-1" role="main">
      <slot />
    </main>

    <footer class="border-t border-border py-8 bg-surface" role="contentinfo">
      <div class="container">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-text-muted">
          <p>&copy; {new Date().getFullYear()} Pojok Baca RPL. Dibangun dengan Astro & Tailwind.</p>
          <div class="flex items-center gap-4">
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-text transition-colors" aria-label="GitHub Repository">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
            </a>
            <a href="https://id.welib.org" target="_blank" rel="noopener noreferrer" class="hover:text-text transition-colors" aria-label="Data buku dari Welib.org">
              <span class="text-xs font-medium">Data: Welib</span>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <!-- View Transitions for smooth page navigation -->
    <script is:inline>
      if ('navigation' in window) {
        document.documentElement.classList.add('view-transitions');
      }
    </script>
  </body>
</html>