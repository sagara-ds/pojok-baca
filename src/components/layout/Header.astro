---
// Header component — navigasi utama + pencarian.
import SearchBox from './SearchBox.astro';

interface Props {
  currentPath?: string;
  hideSearch?: boolean;
}

const { currentPath, hideSearch = false } = Astro.props;

const fullPath = currentPath ?? `${Astro.url.pathname}${Astro.url.search}`;
const basePath = fullPath.split('?')[0] ?? '';
const normalizedPath = basePath.replace(/\/+$/, '') || '/';

// trailingSlash: 'always' — semua internal link wajib berakhir '/'.
const navItems = [
  { href: '/books/', label: 'Katalog', match: (p: string) => p === '/books' || p.startsWith('/books/') },
  { href: '/riwayat/', label: 'Riwayat Baca', match: (p: string) => p.startsWith('/riwayat') },
  { href: '/bookmark/', label: 'Bookmark', match: (p: string) => p.startsWith('/bookmark') },
  { href: '/setting/', label: 'Setting', match: (p: string) => p.startsWith('/setting') },
];

const isActive = (item: (typeof navItems)[number]) => item.match(normalizedPath);
---

<header class="border-b border-border sticky top-0 z-40 bg-background/95 backdrop-blur-sm" role="banner">
  <div class="container">
    <div class="flex items-center justify-between gap-4 h-16">
      <!-- Logo/Title -->
      <a href="/" class="flex items-center gap-2 text-primary font-semibold text-lg flex-shrink-0" aria-label="Pojok Baca RPL - Beranda">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-accent">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
          <path d="M8 10h10" />
          <path d="M8 14h10" />
        </svg>
        <span class="hidden sm:inline">Pojok Baca RPL</span>
      </a>

      <!-- Desktop search: selalu terlihat, bukan ikon yatim -->
      {!hideSearch && (
        <div class="hidden md:block w-full max-w-xs lg:max-w-sm">
          <SearchBox compact />
        </div>
      )}

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 flex-shrink-0" role="navigation" aria-label="Navigasi utama">
        {navItems.map(item => {
          const active = isActive(item);
          return (
            <a
              href={item.href}
              class={`px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
                active ? 'bg-primary/10 text-primary' : 'text-text-muted hover:text-text hover:bg-secondary'
              }`}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Mobile controls: search icon + hamburger -->
      <div class="md:hidden flex items-center gap-1 ml-auto flex-shrink-0">
        {!hideSearch && (
          <button
            type="button"
            class="p-2 rounded-lg text-text-muted hover:text-text hover:bg-secondary transition-colors"
            aria-label="Buka pencarian"
            aria-expanded="false"
            aria-controls="mobile-search-panel"
            data-mobile-search-toggle
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
          </button>
        )}

        <button
          class="p-2 rounded-lg text-text-muted hover:text-text hover:bg-secondary transition-colors"
          aria-label="Buka menu navigasi"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-mobile-menu-toggle
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Search Panel -->
    {!hideSearch && (
      <div id="mobile-search-panel" class="md:hidden hidden py-3 px-4 border-t border-border bg-background">
        <SearchBox />
      </div>
    )}

    <!-- Mobile Navigation -->
    <nav id="mobile-menu" class="md:hidden hidden border-t border-border bg-background" role="navigation" aria-label="Navigasi mobile">
      <div class="py-3 px-4">
        <div class="space-y-1">
          {navItems.map(item => {
            const active = isActive(item);
            return (
              <a
                href={item.href}
                class={`block px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
                  active ? 'bg-primary/10 text-primary' : 'text-text-muted hover:text-text hover:bg-secondary'
                }`}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          })}
        </div>
      </div>
    </nav>
  </div>

  <script is:inline>
    // Menu & search mobile saling menutup
    const menuToggle = document.querySelector('[data-mobile-menu-toggle]');
    const menu = document.getElementById('mobile-menu');
    const mobileSearchToggle = document.querySelector('[data-mobile-search-toggle]');
    const mobileSearchPanel = document.getElementById('mobile-search-panel');

    function setMobileMenuOpen(open) {
      if (!menu) return;
      menu.classList.toggle('hidden', !open);
      if (menuToggle) menuToggle.setAttribute('aria-expanded', String(open));
    }

    function setMobileSearchOpen(open) {
      if (!mobileSearchPanel) return;
      mobileSearchPanel.classList.toggle('hidden', !open);
      if (mobileSearchToggle) mobileSearchToggle.setAttribute('aria-expanded', String(open));
      if (open) {
        const input = mobileSearchPanel.querySelector('input');
        if (input) input.focus();
      }
    }

    if (menuToggle && menu) {
      menuToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        setMobileSearchOpen(false);
        setMobileMenuOpen(menu.classList.contains('hidden'));
      });
    }

    if (mobileSearchToggle && mobileSearchPanel) {
      mobileSearchToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        setMobileMenuOpen(false);
        setMobileSearchOpen(mobileSearchPanel.classList.contains('hidden'));
      });
    }

    // Klik di luar menutup keduanya
    document.addEventListener('click', (e) => {
      if (menu && menuToggle && !menu.contains(e.target) && !menuToggle.contains(e.target)) {
        setMobileMenuOpen(false);
      }
      if (
        mobileSearchPanel &&
        mobileSearchToggle &&
        !mobileSearchPanel.contains(e.target) &&
        !mobileSearchToggle.contains(e.target)
      ) {
        setMobileSearchOpen(false);
      }
    });
  </script>
</header>
