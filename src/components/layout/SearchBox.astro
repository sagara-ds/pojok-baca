---
import { debounce } from '../../utils/debounce';
const resultsId = `search-results-${Math.random().toString(36).slice(2, 9)}`;
---

<form action="/books/" method="get" role="search" data-search-box class="w-full">
  <div class="relative">
    <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-surface border border-border focus-within:border-primary focus-within:outline-none focus-within:ring-1 focus-within:ring-primary/50 transition-colors">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-muted flex-shrink-0" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>

      <input
        type="search"
        name="q"
        placeholder="Cari buku, penulis..."
        autocomplete="off"
        aria-label="Cari buku"
        aria-expanded="false"
        aria-haspopup="listbox"
        aria-controls={resultsId}
        class="flex-1 bg-transparent text-text placeholder-text-muted outline-none text-sm"
        data-search-input
      />

      <button
        type="button"
        aria-label="Hapus pencarian"
        data-clear-btn
        class="p-1 text-text-muted hover:text-text transition-colors hidden"
        tabindex="-1"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="hidden" data-loading-spinner aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" class="animate-spin text-text-muted" stroke="currentColor" stroke-width="2" fill="none">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-opacity="0.25"></circle>
          <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor"></path>
        </svg>
      </div>
    </div>

    <div id={resultsId} role="listbox" data-search-results class="hidden absolute top-full left-0 right-0 mt-2 bg-surface border border-border rounded-lg shadow-lg max-h-80 overflow-y-auto z-50">
      <div class="p-3 text-sm text-text-muted text-center" data-empty-state hidden>
        Tidak ada hasil untuk "<span data-query></span>"
      </div>

      <div class="p-3 text-sm text-text-muted text-center" data-loading-state hidden>
        Memuat…
      </div>

      <div class="p-3 text-sm text-red-500 text-center" data-error-state hidden>
        Gagal memuat hasil. Coba lagi.
      </div>

      <div data-results-list class="divide-y divide-border"></div>

      <a href="/books/" data-view-all-link class="block px-3 py-2 text-center text-sm font-medium text-primary hover:bg-secondary/50 transition-colors border-t border-border hidden">
        Lihat semua hasil
      </a>
    </div>
  </div>
</form>

<script>
  import { debounce } from '../../utils/debounce';

  interface SearchResult {
    slug: string;
    title: string;
    author: string;
    coverUrl: string;
  }

  interface SearchResponse {
    data: SearchResult[];
    pagination: {
      page: number;
      limit: number;
      total: number;
      totalPages: number;
    };
  }

  const DEBOUNCE_MS = 300;
  const MIN_QUERY = 2;
  const LIMIT = 8;

  function initSearchBox(form: Element) {
    const input = form.querySelector<HTMLInputElement>('[data-search-input]');
    const resultsContainer = form.querySelector<HTMLElement>('[data-search-results]');
    const resultsList = form.querySelector<HTMLElement>('[data-results-list]');
    const emptyState = form.querySelector<HTMLElement>('[data-empty-state]');
    const loadingState = form.querySelector<HTMLElement>('[data-loading-state]');
    const errorState = form.querySelector<HTMLElement>('[data-error-state]');
    const querySpan = form.querySelector<HTMLElement>('[data-query]');
    const clearBtn = form.querySelector<HTMLButtonElement>('[data-clear-btn]');
    const loadingSpinner = form.querySelector<HTMLElement>('[data-loading-spinner]');
    const viewAllLink = form.querySelector<HTMLAnchorElement>('[data-view-all-link]');

    if (!input || !resultsContainer || !resultsList) return;

    let abortController: AbortController | null = null;

    function hideResults() {
      resultsContainer.classList.add('hidden');
      input.setAttribute('aria-expanded', 'false');
    }

    function showResults() {
      resultsContainer.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
    }

    function showState(state: 'empty' | 'loading' | 'error' | 'results') {
      emptyState?.classList.add('hidden');
      loadingState?.classList.add('hidden');
      errorState?.classList.add('hidden');
      resultsList?.classList.add('hidden');
      viewAllLink?.classList.add('hidden');
      loadingSpinner?.classList.add('hidden');

      switch (state) {
        case 'empty':
          emptyState?.classList.remove('hidden');
          break;
        case 'loading':
          loadingState?.classList.remove('hidden');
          loadingSpinner?.classList.remove('hidden');
          break;
        case 'error':
          errorState?.classList.remove('hidden');
          break;
        case 'results':
          resultsList?.classList.remove('hidden');
          viewAllLink?.classList.remove('hidden');
          break;
      }
    }

    function highlightMatch(text: string, query: string): HTMLElement {
      const span = document.createElement('span');
      const q = query.toLowerCase();
      const lower = text.toLowerCase();
      const idx = lower.indexOf(q);

      if (idx === -1) {
        span.textContent = text;
        return span;
      }

      const before = text.slice(0, idx);
      const match = text.slice(idx, idx + q.length);
      const after = text.slice(idx + q.length);

      span.append(
        document.createTextNode(before),
        Object.assign(document.createElement('mark'), { textContent: match }),
        document.createTextNode(after)
      );

      return span;
    }

    function renderResults(results: SearchResult[], query: string) {
      resultsList!.innerHTML = '';
      results.forEach(book => {
        const link = document.createElement('a');
        link.href = `/books/${book.slug}/`;
        link.role = 'option';
        link.className =
          'flex gap-3 p-2 hover:bg-secondary/50 transition-colors group cursor-pointer';

        const coverImg = document.createElement('img');
        coverImg.src = book.coverUrl;
        coverImg.alt = `Cover ${book.title}`;
        coverImg.className = 'w-12 h-16 object-cover rounded flex-shrink-0 bg-secondary';
        coverImg.loading = 'lazy';

        const infoDiv = document.createElement('div');
        infoDiv.className = 'flex-1 min-w-0';

        const titleP = document.createElement('p');
        titleP.className = 'font-medium text-sm text-text line-clamp-2';
        titleP.append(highlightMatch(book.title, query));

        const authorP = document.createElement('p');
        authorP.className = 'text-xs text-text-muted line-clamp-1';
        authorP.textContent = book.author;

        infoDiv.append(titleP, authorP);
        link.append(coverImg, infoDiv);
        resultsList!.append(link);
      });

      showState('results');
      showResults();
    }

    const performSearch = debounce(async (query: string) => {
      const trimmed = query.trim();

      if (trimmed.length < MIN_QUERY) {
        hideResults();
        return;
      }

      abortController?.abort();
      abortController = new AbortController();

      showState('loading');
      showResults();

      if (querySpan) querySpan.textContent = trimmed;
      if (viewAllLink) viewAllLink.href = `/books/?q=${encodeURIComponent(trimmed)}`;

      try {
        const response = await fetch(
          `/api/search/?q=${encodeURIComponent(trimmed)}&limit=${LIMIT}`,
          { signal: abortController.signal }
        );

        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        const data: SearchResponse = await response.json();

        if (data.data.length === 0) {
          showState('empty');
        } else {
          renderResults(data.data, trimmed);
        }
      } catch (err) {
        if (err instanceof Error && err.name === 'AbortError') return;
        showState('error');
      }
    }, DEBOUNCE_MS);

    input.addEventListener('input', e => {
      const query = (e.target as HTMLInputElement).value;
      clearBtn?.classList.toggle('hidden', query.length === 0);
      performSearch(query);
    });

    input.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        hideResults();
        input.value = '';
        clearBtn?.classList.add('hidden');
      }
    });

    clearBtn?.addEventListener('click', () => {
      input.value = '';
      clearBtn.classList.add('hidden');
      hideResults();
      performSearch('');
    });

    form.addEventListener('submit', () => {
      hideResults();
      abortController?.abort();
    });

    document.addEventListener('click', e => {
      if (!form.contains(e.target as Node)) {
        hideResults();
      }
    });

    input.addEventListener('focus', () => {
      if (input.value.length >= MIN_QUERY) {
        showResults();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-search-box]').forEach(initSearchBox);
  });
</script>
