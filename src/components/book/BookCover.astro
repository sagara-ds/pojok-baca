---
// Book cover component dengan gambar responsif + placeholder desain.
//
// Placeholder bergaya sampul (CoverPlaceholder) selalu dirender di
// belakang <img>: saat asset cover belum ada / 404, img disembunyikan
// lewat onerror dan desain placeholder yang tampil — tidak pernah ada
// kotak abu-abu kosong atau ikon rusak.
import CoverPlaceholder from './CoverPlaceholder.astro';

interface Props {
  /** URL cover; boleh kosong → langsung tampilkan desain placeholder */
  src?: string;
  /** Judul & penulis untuk tipografi placeholder desain */
  title: string;
  author?: string;
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
  priority?: boolean; // For above-the-fold images
}

const {
  src,
  title,
  author,
  alt = 'Cover buku',
  width = 256,
  height = 384,
  class: className = '',
  priority = false,
} = Astro.props;

const loading = priority ? 'eager' : 'lazy';
const fetchPriority = priority ? 'high' : 'auto';

const aspectRatioStyle = `aspect-ratio: ${width} / ${height};`;

const containerClasses = `relative overflow-hidden rounded-lg bg-[#0f3c65] ${className}`;
const imageClasses =
  'absolute inset-0 w-full h-full object-cover transition-opacity duration-300';
---

<div class={containerClasses} style={aspectRatioStyle} role="img" aria-label={alt}>
  <!-- Placeholder desain (selalu ada, di belakang img) -->
  <CoverPlaceholder title={title} author={author} />

  <!-- Cover asli di atas placeholder; onerror menyembunyikan img -->
  {src && (
    <img
      src={src}
      alt={alt}
      loading={loading}
      fetchpriority={fetchPriority}
      width={width}
      height={height}
      class={imageClasses}
      onerror="this.style.display='none'"
      decoding="async"
    />
  )}
</div>
