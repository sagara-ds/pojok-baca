---
// Skeleton loading component
interface Props {
  variant?: 'text' | 'circular' | 'rectangular' | 'book-card' | 'book-detail';
  width?: string | number;
  height?: string | number;
  class?: string;
  count?: number; // For text variant - number of lines
}

const {
  variant = 'rectangular',
  width,
  height,
  class: className = '',
  count = 3,
} = Astro.props;

const baseStyles = 'skeleton';

const variantStyles = {
  text: 'h-4 rounded',
  circular: 'rounded-full',
  rectangular: 'rounded-lg',
  'book-card': 'rounded-xl',
  'book-detail': 'rounded-xl',
};

const classes = `${baseStyles} ${variantStyles[variant]} ${className}`;

const inlineStyles = `
  ${width ? `width: ${typeof width === 'number' ? `${width}px` : width};` : ''}
  ${height ? `height: ${typeof height === 'number' ? `${height}px` : height};` : ''}
`;
---

{variant === 'text' ? (
  <div class="space-y-2" role="status" aria-label="Memuat teks">
    {Array.from({ length: count }).map((_, i) => (
      <div
        class={classes}
        style={inlineStyles + (i === count - 1 ? 'width: 70%;' : '')}
        aria-hidden="true"
      />
    ))}
  </div>
) : variant === 'book-card' ? (
  <article class="space-y-3" role="status" aria-label="Memuat kartu buku">
    <div class={classes} style="aspect-ratio: 2/3; width: 100%;" aria-hidden="true" />
    <div class="space-y-2">
      <div class="skeleton h-5 rounded w-3/4" aria-hidden="true" />
      <div class="skeleton h-4 rounded w-1/2" aria-hidden="true" />
      <div class="skeleton h-4 rounded w-full" aria-hidden="true" />
      <div class="skeleton h-4 rounded w-5/6" aria-hidden="true" />
    </div>
  </article>
) : variant === 'book-detail' ? (
  <div class="grid gap-6 sm:grid-cols-[auto_1fr] items-start" role="status" aria-label="Memuat detail buku">
    <div class={classes} style="aspect-ratio: 2/3; width: 100%; max-width: 256px;" aria-hidden="true" />
    <div class="space-y-4">
      <div class="skeleton h-8 rounded w-3/4" aria-hidden="true" />
      <div class="skeleton h-5 rounded w-1/2" aria-hidden="true" />
      <div class="space-y-2">
        <div class="skeleton h-4 rounded w-full" aria-hidden="true" />
        <div class="skeleton h-4 rounded w-full" aria-hidden="true" />
        <div class="skeleton h-4 rounded w-5/6" aria-hidden="true" />
      </div>
      <div class="skeleton h-12 rounded w-48" aria-hidden="true" />
    </div>
  </div>
) : (
  <div
    class={classes}
    style={inlineStyles}
    role="status"
    aria-label="Memuat konten"
    aria-hidden="true"
  />
)}