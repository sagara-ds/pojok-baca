<dialog id="student-reset-dialog" class="m-auto w-[calc(100%-2rem)] max-w-md rounded-xl border border-border bg-surface p-5 text-text backdrop:bg-black/55"
  aria-labelledby="student-reset-heading" aria-describedby="student-reset-description">
  <h2 id="student-reset-heading" class="font-serif text-xl font-semibold">Reset kata sandi siswa</h2>
  <p id="student-reset-description" class="mt-2 text-sm text-text-muted">
    Buat kata sandi sementara untuk <strong data-reset-name></strong>. Siswa akan diminta masuk lagi dan menggantinya.
  </p>
  <p data-reset-status class="mt-3 text-sm" role="status"></p>
  <div data-reset-result class="mt-4 space-y-2" hidden>
    <label class="grid gap-1 text-sm font-semibold">
      Kata sandi sementara
      <input data-temporary-password type="text" autocomplete="off" spellcheck="false" readonly />
    </label>
    <p class="text-sm text-text-muted">Salin dan berikan secara pribadi. Kata sandi ini ditampilkan sekali.</p>
    <button data-copy-password type="button" class="interaction-control rounded-lg border border-border px-3 py-2 text-sm font-semibold hover:bg-secondary">Salin kata sandi</button>
  </div>
  <form class="mt-4 flex flex-wrap justify-end gap-2">
    <button type="button" data-reset-close class="interaction-control rounded-lg border border-border px-3 py-2 text-sm font-semibold hover:bg-secondary">Batal</button>
    <button type="submit" data-reset-submit class="interaction-control rounded-lg bg-primary px-3 py-2 text-sm font-bold text-background hover:bg-primary-dark">Buat kata sandi sementara</button>
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#student-reset-dialog')!;
  const form = dialog.querySelector('form')!;
  const name = dialog.querySelector('[data-reset-name]')!;
  const status = dialog.querySelector('[data-reset-status]')!;
  const result = dialog.querySelector<HTMLElement>('[data-reset-result]')!;
  const password = dialog.querySelector<HTMLInputElement>('[data-temporary-password]')!;
  const submit = dialog.querySelector<HTMLButtonElement>('[data-reset-submit]')!;
  const close = dialog.querySelector<HTMLButtonElement>('[data-reset-close]')!;
  const copy = dialog.querySelector<HTMLButtonElement>('[data-copy-password]')!;
  let student = '';
  let busy = false;

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-reset-student]')) {
    button.hidden = false;
    button.addEventListener('click', () => {
      student = button.dataset.resetStudent ?? '';
      name.textContent = button.dataset.studentName ?? '';
      dialog.showModal();
      close.focus();
    });
  }
  dialog.addEventListener('cancel', (event) => { if (busy) event.preventDefault(); });
  close.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => {
    password.value = '';
    result.hidden = true;
    submit.hidden = false;
    close.textContent = 'Batal';
    status.textContent = '';
    student = '';
  });
  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(password.value);
      status.textContent = 'Kata sandi disalin.';
    } catch {
      password.select();
      status.textContent = 'Salin kata sandi yang sudah dipilih.';
    }
  });
  window.addEventListener('pagehide', () => {
    password.value = '';
    dialog.close();
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (busy || !student) return;
    busy = true;
    submit.disabled = close.disabled = true;
    status.textContent = 'Mereset kata sandi…';
    try {
      const response = await fetch('/api/admin/password-reset/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: student }),
      });
      const data = await response.json();
      if (!dialog.open || !student) return;
      if (!response.ok || typeof data.password !== 'string') {
        status.textContent = data.error === 'auth_permission_required'
          ? 'Akun ini memerlukan izin reset kata sandi di Neon Auth.'
          : data.error === 'not_available'
            ? 'Akun siswa sedang diproses atau sudah tidak tersedia. Muat ulang daftar dan coba lagi.'
            : 'Reset belum dapat dikonfirmasi. Coba lagi.';
        return;
      }
      password.value = data.password;
      result.hidden = false;
      submit.hidden = true;
      close.textContent = 'Selesai';
      status.textContent = 'Kata sandi sementara siap disalin.';
      password.focus();
    } catch {
      status.textContent = 'Reset belum dapat dikonfirmasi. Coba lagi.';
    } finally {
      busy = false;
      submit.disabled = close.disabled = false;
    }
  });
</script>
