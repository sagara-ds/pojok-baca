---
// Error state component
interface Props {
  title?: string;
  message?: string;
  actionLabel?: string;
  actionHref?: string;
  actionOnclick?: (event: Event) => void;
  variant?: 'default' | 'inline' | 'page';
  class?: string;
  icon?: boolean;
}

const {
  title = 'Terjadi Kesalahan',
  message = 'Maaf, terjadi kesalahan saat memuat data. Silakan coba lagi nanti.',
  actionLabel = 'Coba Lagi',
  actionHref,
  actionOnclick,
  variant = 'default',
  class: className = '',
  icon = true,
} = Astro.props;

const baseStyles = 'text-center';

const variantStyles = {
  default: 'py-12 px-4',
  inline: 'py-6 px-4',
  page: 'flex-1 flex items-center justify-center px-4',
};

const classes = `${baseStyles} ${variantStyles[variant]} ${className}`;

const errorIcon = `
  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-4 text-error/50" aria-hidden="true">
    <circle cx="12" cy="12" r="10" />
    <line x1="12" y1="8" x2="12" y2="12" />
    <line x1="12" y1="16" x2="12.01" y2="16" />
  </svg>
`;
---

<div class={classes} role="alert">
  {icon && <div aria-hidden="true">{errorIcon}</div>}
  <h2 class="text-lg font-semibold text-text mb-2">{title}</h2>
  <p class="text-text-muted mb-4">{message}</p>
  {actionHref ? (
    <a href={actionHref} class="inline-flex items-center gap-2 text-accent hover:text-accent-dark font-medium transition-colors">
      {actionLabel}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5" />
        <path d="M12 19l-7-7 7-7" />
      </svg>
    </a>
  ) : actionOnclick ? (
    <button type="button" class="inline-flex items-center gap-2 text-accent hover:text-accent-dark font-medium transition-colors" onclick={actionOnclick}>
      {actionLabel}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M23 4v16h-16" />
        <path d="M1 20l10-10" />
        <path d="M11 10l-10 10" />
      </svg>
    </button>
  ) : ''}
</div>