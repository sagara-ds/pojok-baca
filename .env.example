# Sumber data saat ini: Open Library (tanpa API key — tidak perlu env)

# Opsional: aktifkan Google Books client (src/services/googlebooks.ts)
# Dapatkan key gratis: console.cloud.google.com → APIs & Services → Library → "Books API" → Enable → Credentials → API key
# Kuota gratis: 1.000 request/hari. Tanpa key, kuota anonymous = 0/hari (selalu 429).
# GOOGLE_BOOKS_API_KEY=

# Opsional: paksa seluruh app memakai data mock (dev / demo / analog dev)
# PUBLIC_USE_MOCK=false
