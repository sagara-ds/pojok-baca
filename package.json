{
  "name": "pojok-baca",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "db:import-catalog": "node --env-file-if-exists=.env pipeline/import-catalog.mjs",
    "db:import-students": "node --env-file-if-exists=.env --env-file-if-exists=.env.import-students pipeline/import-students.mjs",
    "storage:stage-legacy": "node pipeline/stage-private-assets.mjs",
    "storage:migrate-github": "node pipeline/migrate-github-strips.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "pipe": "node pipeline/cli.mjs",
    "pipe:list": "node pipeline/cli.mjs list",
    "pipe:fetch": "node pipeline/cli.mjs fetch",
    "pipe:scan": "node pipeline/cli.mjs scan",
    "pipe:render": "node pipeline/cli.mjs render",
    "pipe:covers": "node pipeline/cli.mjs covers",
    "pipe:manifest": "node pipeline/cli.mjs manifest",
    "pipe:text": "node pipeline/cli.mjs text",
    "pipe:pdf": "node pipeline/cli.mjs pdf",
    "pipe:verify": "node pipeline/cli.mjs verify",
    "pipe:bundle": "node pipeline/cli.mjs bundle",
    "pipe:all": "node pipeline/cli.mjs all",
    "deploy": "astro build && wrangler deploy -c dist/server/wrangler.json",
    "deploy:check": "astro build && wrangler deploy -c dist/server/wrangler.json --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.1",
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@neon/auth": "^0.8.2",
    "@neondatabase/serverless": "^1.2.1",
    "astro": "^7.4.1",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/node": "^11.1.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "csv-parse": "^7.0.3",
    "read-excel-file": "^9.3.17",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.3"
  }
}
