{
  "name": "pojok-baca",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "pipe": "node pipeline/cli.mjs",
    "pipe:list": "node pipeline/cli.mjs list",
    "pipe:fetch": "node pipeline/cli.mjs fetch",
    "pipe:scan": "node pipeline/cli.mjs scan",
    "pipe:render": "node pipeline/cli.mjs render",
    "pipe:manifest": "node pipeline/cli.mjs manifest",
    "pipe:pdf": "node pipeline/cli.mjs pdf",
    "pipe:verify": "node pipeline/cli.mjs verify",
    "pipe:bundle": "node pipeline/cli.mjs bundle",
    "pipe:all": "node pipeline/cli.mjs all",
    "deploy": "astro build && wrangler deploy -c dist/server/wrangler.json",
    "deploy:check": "astro build && wrangler deploy -c dist/server/wrangler.json --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.1",
    "astro": "^7.4.1"
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.9",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.151.3"
  }
}
